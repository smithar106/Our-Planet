# Frontend environment
# Copy to .env.local and fill in values. .env.local is gitignored.

# Public API base URL (server-side rewrites proxy /api/* to this).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Mapbox public token (client-safe, `pk.` prefix). Leave empty to use the free
# OpenFreeMap fallback style.
NEXT_PUBLIC_MAPBOX_TOKEN=
