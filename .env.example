# PLANET environment configuration
# Copy to .env and fill in real values. NEVER commit .env.

# --- Database ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://planet:planet@localhost:5432/planet

# --- Data sources --------------------------------------------------------
# FIRMS map key — server-side only, never exposed to the client.
NASA_FIRMS_MAP_KEY=

# --- LLM ----------------------------------------------------------------
# Supports any OpenAI-compatible provider (DeepSeek by default).
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=

# --- Agent ---------------------------------------------------------------
# Significance score threshold that triggers agent investigation.
AGENT_THRESHOLD=50

# --- Pipeline cadence (seconds) ------------------------------------------
USGS_INTERVAL_SECONDS=300
EONET_INTERVAL_SECONDS=900
FIRMS_INTERVAL_SECONDS=1800
BRIEF_INTERVAL_SECONDS=86400

# --- Observability -------------------------------------------------------
# memory | null | mlflow
TRACING_BACKEND=memory
MLFLOW_TRACKING_URI=

# --- Misc ----------------------------------------------------------------
LOG_LEVEL=INFO
CORS_ORIGINS=*
